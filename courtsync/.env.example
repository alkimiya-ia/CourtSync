# Copy to .env.local for development. In Cloudflare Pages, set these as environment variables.
# Both values are public (the anon key is safe in the browser; RLS protects the data).
# NEVER put the service_role key in this file or in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
